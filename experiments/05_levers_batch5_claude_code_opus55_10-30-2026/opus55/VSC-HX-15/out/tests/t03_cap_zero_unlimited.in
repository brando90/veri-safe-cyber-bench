site add AMS "Amsterdam hub"
site add LHR "London Heathrow"
site add JFK "New York"
route add R3 AMS LHR JFK
set cap 2
ship add S1 "No cap" route=R3 class=chilled cap=0
ship add S2 "Global cap" route=R3 class=chilled
read S1 t=0 temp=4.0
read S1 t=60 temp=4.0
read S1 t=120 temp=4.0
read S1 t=180 temp=4.0
read S2 t=0 temp=4.0
read S2 t=60 temp=4.0
read S2 t=120 temp=4.0
set cap 0
read S2 t=180 temp=4.0
read S2 t=240 temp=4.0
ship show S1
ship show S2
ship list
stats
