site add AMS "Amsterdam hub"
site add LHR "London Heathrow"
site add JFK "New York"
route add R3 AMS LHR JFK
ship add S1 "Warm probe" route=R3 class=ambient offset=-2.0
ship add S2 "Cold probe" route=R3 class=frozen offset=1.5
read S1 t=0 temp=61.0
read S1 t=60 temp=62.5
read S1 t=120 temp=59.0
read S2 t=0 temp=-41.0
read S2 t=60 temp=-45.0
read S2 t=120 temp=-39.0
window S1
window S2
