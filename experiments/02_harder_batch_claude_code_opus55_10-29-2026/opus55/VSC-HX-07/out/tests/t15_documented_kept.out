tenant acme plan=pro
tenant bolt plan=pro
key acme.main issued expires=never
key bolt.main issued expires=never
config tenant:acme rate.limit=2
ok 200 miss 2048B catalog items=12 rev=3
ok 200 hit 2048B catalog items=12 rev=3
now=20000
ok 200 miss 240B items tenant=acme n=2
deny rate retry_after=40
now=59999
deny rate retry_after=1
now=60000
ok 200 hit 240B items tenant=acme n=2
ok 200 miss 240B items tenant=bolt n=2
entry acme GET /v1/items?n=2 size=1KiB expires=140000 hits=1
entry bolt GET /v1/items?n=2 size=1KiB expires=180000 hits=0
check ok records=12
