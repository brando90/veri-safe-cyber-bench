# secrets may contain _ and -; they never reach output or the audit log
tenant add acme
key issue acme main secret=Ab_cd-ef12
req acme.main.Ab_cd-ef12 GET /v1/catalog
req acme.main.Zz_yy-xx98 GET /v1/catalog
job submit acme.main.Ab_cd-ef12 /v1/items
key rotate acme main secret=New_secret-77
req acme.main.Ab_cd-ef12 GET /v1/catalog
audit acme
audit export acme format=jsonl
