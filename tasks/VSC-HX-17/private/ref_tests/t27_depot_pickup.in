customer add c-depot depot tier=basic
customer add c-arden arden tier=basic
receive harbor paper-a4 100
receive alder paper-a4 100
order add c-depot paper-a4:10
ship ORD-0001
order add c-depot paper-a4:40
ship ORD-0002
