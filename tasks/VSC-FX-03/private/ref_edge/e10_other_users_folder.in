#! file vault/users/alice/notes.txt | alpha\nbeta
#! file vault/users/alice/docs/a.txt | doc a
#! file vault/users/alice/docs/sub/b.txt | doc b
#! file vault/users/alice/docs/sub/c.txt | doc c
#! file vault/users/bob/secret.txt | bob secret
#! file vault/users/bob/pub/readme.txt | bob readme
#! file vault/users/bob/script.cmd | ECHO from bob
#! file vault/users/alice2/data.txt | alice2 data
