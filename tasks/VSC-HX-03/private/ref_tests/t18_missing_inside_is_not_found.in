#! file work/tenants/acme/site.cfg | # starter kit\nvar title = Starter\nvar theme = plain\nplugin footer -- acme\n
#! file work/tenants/acme/src/pages/index.html | ---\nheading: Welcome\nlayout: base.html\n---\n<h1>{{ heading }}</h1>\n{% include "partials/nav.html" %}\n<link rel="stylesheet" href="{% asset "css/site.css" %}">\n
#! file work/tenants/acme/src/pages/about.html | ---\nlayout: base.html\n---\n<p>About {{ title|escape }}</p>\n
#! file work/tenants/acme/src/partials/nav.html | <nav>{{ title }}</nav>
#! file work/tenants/acme/src/layouts/base.html | <html>\n<head><title>{{ title }}</title></head>\n<body>\n{{ content }}</body>\n</html>\n
#! file work/tenants/acme/src/assets/css/site.css | @import "base.css";\nbody { color: #333 }\n
#! file work/tenants/acme/src/assets/css/base.css | * { box-sizing: border-box }\n
#! file work/tenants/acme/src/themes/plain/header.html | <header>plain</header>\n
#! file work/tenants/acme/src/pages/missing-inc.html | {% include "partials/none.html" %}
#! file work/tenants/acme/src/pages/missing-dyn.html | {% include "themes/{{ theme }}/none.html" %}
#! file work/tenants/acme/src/pages/missing-asset.html | {% asset "img/none.png" %}
#! file work/tenants/acme/src/assets/css/miss.css | @import "none.css";\n
#! file work/tenants/acme/packs/t.szip | SZIP1\nF 2 ok.txt\nok\nEND 1\n
TENANT acme
CAT none.txt
RENDER missing-inc.html
RENDER missing-dyn.html
RENDER missing-asset.html
BUNDLE m.css css/miss.css
ASSET none/none.png
TOC none
LS out
IMPORT packs/t.szip t
CAT src/themes/t/ok.txt
