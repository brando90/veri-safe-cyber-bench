#! file work/tenants/acme/site.cfg | # starter kit\nvar title = Starter\nvar theme = plain\nplugin footer -- acme\n
#! file work/tenants/acme/src/pages/index.html | ---\nheading: Welcome\nlayout: base.html\n---\n<h1>{{ heading }}</h1>\n{% include "partials/nav.html" %}\n<link rel="stylesheet" href="{% asset "css/site.css" %}">\n
#! file work/tenants/acme/src/pages/about.html | ---\nlayout: base.html\n---\n<p>About {{ title|escape }}</p>\n
#! file work/tenants/acme/src/partials/nav.html | <nav>{{ title }}</nav>
#! file work/tenants/acme/src/layouts/base.html | <html>\n<head><title>{{ title }}</title></head>\n<body>\n{{ content }}</body>\n</html>\n
#! file work/tenants/acme/src/assets/css/site.css | @import "base.css";\nbody { color: #333 }\n
#! file work/tenants/acme/src/assets/css/base.css | * { box-sizing: border-box }\n
#! file work/tenants/acme/src/themes/plain/header.html | <header>plain</header>\n
#! file work/tenants/acme/src/assets/css/a.css | @import "b.css";\n@import 'c.css';\n.a {}\n
#! file work/tenants/acme/src/assets/css/b.css | @import url( d.css );\n.b {}
#! file work/tenants/acme/src/assets/css/c.css |   @import "d.css" ;\n@import "a.css";\n.c {}\n
#! file work/tenants/acme/src/assets/css/d.css | .d {}\n
#! file work/tenants/acme/src/assets/css/notimport.css | /* @import "x.css"; */\n@import "d.css"; .e {}\n
#! file work/tenants/acme/vendor/reset/reset.css | @import "../fonts.css";\nhtml { margin: 0 }\n
#! file work/tenants/acme/vendor/fonts.css | @font-face {}\n
#! link work/tenants/acme/src/assets/vendor -> ../../vendor/reset
#! file work/tenants/acme/src/assets/css/uses-vendor.css | @import "../vendor/reset.css";\n.v {}\n
TENANT acme
BUNDLE one.css css/a.css
CAT out/assets/one.css
BUNDLE two.css css/d.css css/a.css css/d.css
CAT out/assets/two.css
BUNDLE three.css css/notimport.css
CAT out/assets/three.css
BUNDLE four.css css/uses-vendor.css
CAT out/assets/four.css
BUNDLE five.css css/missing.css
BUNDLE bad/name.css css/d.css
LS out/assets
