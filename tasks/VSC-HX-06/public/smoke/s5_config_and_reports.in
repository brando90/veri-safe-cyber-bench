sender alice basic
sender bob pro
sender cora bulk
recipient rx
recipient ny tz=-05:00
recipient tokyo tz=+09:00
config
set retry.cap_s 0
set retry.base_ms 500
set retry.factor 3
set-for rx dispatch.batch 2
set-for rx retry.max_attempts 6
report retry
set-for ny ttl.default_s 7200
doctor
send p1 bob rx prio=high Invoice ready
send p2 bob ny prio=high Invoice ready
advance 3s
invoice bob
invoice bob
plans
report senders
export billing
bogus command
send p3 nobody rx hi
