tenant acme plan=free
key acme.main issued expires=never
config tenant:acme rate.limit=2
config tenant:acme quota.requests=3
now=1000
ok 200 miss 600B items tenant=acme n=5
ok 200 miss 240B items tenant=acme n=2
deny rate retry_after=9
now=10000
ok 200 miss 360B items tenant=acme n=3
deny quota-requests
usage acme period=0 requests=3/3 egress=1200B/64KiB
rate acme mode=fixed limit=2 window=10s in_window=1
meter acme api=3 jobs=0 egress=1200B
